# .env.example — Voice Satellite Configuration Template
# Copy this file to .env and fill in your actual settings.
#
# Usage:
#   cp .env.example .env

# ─── OpenClaw Gateway Configuration ───────────────────────────────────────────
# Base HTTP/WebSocket URL of the OpenClaw gateway (default: http://127.0.0.1:18789)
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789

# Required bearer token for OpenClaw gateway authentication
OPENCLAW_GATEWAY_TOKEN=your_openclaw_gateway_token

# Target agent ID on the OpenClaw gateway (default: main)
# All voice interactions are routed to this single agent.
OPENCLAW_AGENT_ID=main

# Minimum supported OpenClaw gateway protocol version (default: 3)
GATEWAY_MIN_PROTOCOL=3

# Maximum supported OpenClaw gateway protocol version (default: 4)
GATEWAY_MAX_PROTOCOL=4

# ─── Genie TTS Configuration ──────────────────────────────────────────────────
# Base URL of the Genie TTS server (default: http://127.0.0.1:8000)
GENIE_TTS_URL=http://127.0.0.1:8000

# Voice character name as registered with the Genie TTS server (default: default)
GENIE_CHARACTER_NAME=default

# Absolute path to the character's exported ONNX model directory (Required for TTS)
GENIE_ONNX_MODEL_DIR=/path/to/genie-character/export

# Absolute path to the reference audio WAV file for voice cloning (Required for TTS)
GENIE_REFERENCE_AUDIO=/path/to/character_ref.wav

# Verbatim transcript of the reference audio (Required for TTS)
GENIE_REFERENCE_TEXT=This is the reference audio for the default voice character.

# Language code for Genie TTS (default: en)
GENIE_LANGUAGE=en

# ─── Whisper STT Configuration ────────────────────────────────────────────────
# Faster-Whisper model size/type (default: base.en)
# Options: tiny.en, base.en, small.en, medium.en, large-v3
# Use base.en or small.en for better transcription accuracy
WHISPER_MODEL=base.en

# Whisper transcription language (default: en)
WHISPER_LANGUAGE=en

# ─── Filler Engine Configuration ──────────────────────────────────────────────
# Directory containing pre-rendered PCM filler files (default: static/fillers)
FILLER_DIR=static/fillers

# Seconds to wait for the first TTS chunk before playing a filler audio (default: 2.0)
FILLER_THRESHOLD_SECS=2.0

# ─── Server Configuration ─────────────────────────────────────────────────────
# Bind host address for the FastAPI backend server (default: 0.0.0.0)
HOST=0.0.0.0

# Port number for the FastAPI backend server (default: 8000)
PORT=8000

# ─── Feature Flags / Development ──────────────────────────────────────────────
# Skip Genie TTS server initialization at startup (default: False)
# Set to True/1 for local testing without Genie TTS server running
VOICE_SATELLITE_SKIP_GENIE_INIT=False

# ─── Pipecat Voice Adapter Configuration ──────────────────────────────────────
# Gateway backend type: hermes (default) or openclaw
GATEWAY_BACKEND=hermes

# Base HTTP URL of the Hermes gateway API
HERMES_BASE_URL=http://localhost:8642/v1

# Optional API key for Hermes gateway authentication
HERMES_API_KEY=

# Model name to request from Hermes gateway
HERMES_MODEL=qwen2.5-coder:7b-instruct-q8_0

# Server-Sent Events (SSE) endpoint for Hermes task completions
HERMES_SSE_URL=http://localhost:8642/v1/tasks/sse

# Honcho API base URL (remote context source)
HONCHO_API_URL=http://artemis:8000

# How often to poll Honcho API for memory updates in seconds (default: 25)
HONCHO_POLL_INTERVAL=25

# LiteLLM health endpoint URL for offline state detection
LITELLM_HEALTH_URL=http://localhost:4000/health

# Path to the local disk-backed offline queue JSON file
OFFLINE_QUEUE_PATH=~/.hermes/offline_queue.json

# Path to the directory monitored by watchdog for memory files
HERMES_MEMORY_PATH=~/.hermes/memory

# Offline window start hour (inclusive, e.g. 1 for 1 AM)
OFFLINE_START_HOUR=1

# Offline window end hour (exclusive, e.g. 5 for 5 AM)
OFFLINE_END_HOUR=5

# Audio input sample rate (default: 16000)
AUDIO_IN_SAMPLE_RATE=16000

# Audio output sample rate (default: 32000)
AUDIO_OUT_SAMPLE_RATE=32000

