# .env.example — Voice Satellite configuration template
# Copy to .env and fill in your values.
#
#   cp .env.example .env

# ─── LiteLLM / LLM ───────────────────────────────────────────────────────────

# API key for your LiteLLM proxy
LITELLM_API_KEY=your_litellm_api_key

# LiteLLM proxy base URL (default: https://llm.frizzt.com/v1)
LITELLM_URL=https://llm.frizzt.com/v1

# Model name as exposed by your LiteLLM proxy
LLM_MODEL=qwen-moe-coder-fast

# Maximum conversation history messages kept in the LLM context window (default: 20)
# LLM_HISTORY_MESSAGES=20

# ─── OpenClaw Gateway ─────────────────────────────────────────────────────────

# WebSocket URL of the OpenClaw gateway
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789

# Bearer token for OpenClaw gateway authentication
OPENCLAW_GATEWAY_TOKEN=your_openclaw_token

# ─── Genie TTS ────────────────────────────────────────────────────────────────

# Base URL of the Genie TTS server (default: http://127.0.0.1:8000)
GENIE_TTS_URL=http://127.0.0.1:8000

# Voice character name as recognised by the Genie TTS server
GENIE_CHARACTER_NAME=ordis

# Absolute path to the exported ONNX model directory for the character
GENIE_ONNX_MODEL_DIR=/path/to/genie-ordis/export

# Absolute path to the reference audio WAV file for voice cloning
GENIE_REFERENCE_AUDIO=/path/to/ordis_ref.wav

# Verbatim transcript of the reference audio (used for phoneme alignment)
GENIE_REFERENCE_TEXT=What? A parity drift? How is that possible? Have you executed your diagnostic presets?

# Language code for TTS (default: en)
GENIE_LANGUAGE=en

# Directory containing the genie_tts virtualenv (.venv/ or venv/).
# Auto-detected at <project>/genie_model_reference/ if it exists.
# Override only if your install is somewhere else:
# GENIE_VENV_DIR=/home/aiden/voice-satellite/genie_model_reference

# ─── Whisper STT ──────────────────────────────────────────────────────────────

# Faster-Whisper model size (default: tiny.en)
# Options: tiny.en, base.en, small.en, medium.en, large-v3
WHISPER_MODEL=tiny.en

# Whisper transcription language (default: en)
WHISPER_LANGUAGE=en

# ─── Filler Engine ────────────────────────────────────────────────────────────

# Seconds to wait for the first TTS chunk before playing a filler (default: 2.0)
# FILLER_THRESHOLD_SECS=2.0

# ─── Development / Debug ──────────────────────────────────────────────────────

# Set to 1 to skip Genie TTS initialisation at startup (useful for testing
# server.py without the TTS server running)
# VOICE_SATELLITE_SKIP_GENIE_INIT=0
