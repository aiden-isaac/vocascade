# vocascade — environment configuration
#
# Copy this to .env and fill in the endpoints for your setup:
#   cp .env.example .env
#
# Easier: skip hand-editing and use the setup GUI, which writes this file for you
#   python -m vocascade.setup_server      # -> http://127.0.0.1:8099
#
# `.env` holds secrets + endpoints. Structure (waterfall, skills, latency) lives
# in config.yaml. Required values that are missing/malformed fail fast at startup.

# ═══ Essentials — set these first ════════════════════════════════════════════

# ─── Hermes agent (the "heavy brain": real data + external actions) ───────────
# Base HTTP URL of your Hermes api_server, including /v1.
#   Co-located:        http://localhost:8642/v1
#   Remote (Tailscale): http://your-host:8642/v1
HERMES_BASE_URL=http://localhost:8642/v1
# API key (maps to the Hermes server's API_SERVER_KEY). Leave empty only for
# throwaway localhost tests — unauthenticated servers are unsafe on a network.
HERMES_API_KEY=
# Model name sent with dispatches (informational; the agent decides).
HERMES_MODEL=hermes-agent
# Stable long-term-memory scope, sent as X-Hermes-Session-Key.
HERMES_SESSION_KEY=voice-satellite

# ─── Local LLM (the "fast brain": smalltalk + intent classifier) ──────────────
# Any OpenAI-compatible chat-completions endpoint, including /v1.
LLM_BASE_URL=http://localhost:4000/v1
# API key for the above (empty if your endpoint needs none).
LLM_API_KEY=
# Model name to request.
LLM_MODEL=qwen-moe-coder-fast

# ─── Genie TTS / voice (optional — unset = text-only, no voice cloning) ───────
# Voice runs in degraded (text-only) mode unless the three GENIE_REFERENCE/ONNX
# values below are all set. See scripts/setup_genie.sh.
GENIE_TTS_URL=http://127.0.0.1:8000
GENIE_CHARACTER_NAME=default
# Absolute path to the character's exported ONNX model directory.
GENIE_ONNX_MODEL_DIR=/path/to/genie-character/export
# Absolute path to the reference audio WAV used for cloning.
GENIE_REFERENCE_AUDIO=/path/to/character_ref.wav
# Verbatim transcript of that reference audio.
GENIE_REFERENCE_TEXT=This is the reference audio for the default voice character.
GENIE_LANGUAGE=en

# ─── Speech-to-text (faster-whisper) ──────────────────────────────────────────
# Options: tiny.en, base.en, small.en, medium.en, large-v3
# base.en / small.en give better accuracy; tiny.en is fastest.
WHISPER_MODEL=base.en
WHISPER_LANGUAGE=en

# ─── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8005
AUDIO_IN_SAMPLE_RATE=16000
AUDIO_OUT_SAMPLE_RATE=32000

# ─── Edge / satellite client (mic, wake word) ─────────────────────────────────
# WebSocket URL the edge client connects to.
#   Co-located:        ws://localhost:8005/ws
#   Split (Tailscale):  ws://your-host:8005/ws
WS_URL=ws://localhost:8005/ws
# Local wake-word ONNX model used by the edge client.
WAKE_WORD_MODEL=static/wakeword/eden_wakeword.onnx
# Device-identity transport auth — only used when config.yaml sets
# system.transport_auth_mode: device-identity (trust-network ignores these).
#   EDGE_IDENTITY_KEY_PATH — edge's Ed25519 private key, created on first run.
#   AUTHORIZED_KEYS_PATH   — server trust store (base64 public keys, one per
#                            line). Unset = TOFU (identity proven, not pinned).
EDGE_IDENTITY_KEY_PATH=~/.vocascade/identity.pem
# AUTHORIZED_KEYS_PATH=~/.vocascade/authorized_keys

# ═══ Advanced / optional — sensible defaults, change only if you need to ══════

# Where pre-rendered PCM filler clips live.
FILLER_DIR=static/fillers

# Context hydration for the Hermes pre-fetch cache (default: none = disabled).
#   none | file:///home/me/.hermes | ssh://user@host/home/user/.hermes
HERMES_CONTEXT_SOURCE=none
HERMES_CONTEXT_POLL_INTERVAL=30
# Ephemeral system prompt that shapes Hermes replies for TTS (short, no markdown).
# Voice-only — does not change the agent's profile. Leave default; empty disables.
# HERMES_VOICE_INSTRUCTIONS=
# Token budget for the injected context block (~4 chars/token).
CONTEXT_TOKEN_BUDGET=1200
# Character budget for spoken results before condensation kicks in.
RESULT_SPEECH_BUDGET=600
# Persisted background-task journal.
TASK_JOURNAL_PATH=~/.vocascade/tasks.json

# Honcho context enrichment — OPTIONAL, empty = disabled.
HONCHO_API_URL=
HONCHO_POLL_INTERVAL=25
# Session-end memory gist: URL the assistant POSTs a 1-2 sentence session summary
# to, so locally-handled turns don't diverge the agent's memory. Empty = disabled.
MEMORY_SUMMARY_URL=

# Offline detection + queue: LiteLLM health endpoint, queue file, and the nightly
# window (hours) during which the LLM is treated as offline.
LITELLM_HEALTH_URL=http://localhost:4000/health
OFFLINE_QUEUE_PATH=~/.hermes/offline_queue.json
OFFLINE_START_HOUR=1
OFFLINE_END_HOUR=5

# Skip Genie TTS init at startup (for local testing without the TTS server).
VOICE_SATELLITE_SKIP_GENIE_INIT=False
